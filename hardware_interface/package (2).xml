<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <n>hardware_interface</n>
  <version>0.0.0</version>
  <description>
    Hardware Interface – ROS 2 (Humble / Iron)
    Solo contiene teleop_controller.py (corre en Raspberry Pi 4B).
    Los nodos motor_driver, lights_controller y ultrasonic_sensors
    fueron migrados al ESP32 usando micro-ROS.
  </description>

  <maintainer email="jose@todo.todo">jose</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- teleop_controller necesita estos paquetes en ejecución -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- joy_node (paquete externo para el joystick PS4) -->
  <exec_depend>joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
